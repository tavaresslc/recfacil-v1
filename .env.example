# ID de cliente OAuth do Google (Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=client-id-do-google

VITE_SEARCH_FORM_LIMIT=100
VITE_CHUNK_LIMIT=1000

# Com "true", o login com Google é simulado (não precisa de credenciais reais)
# para rodar o protótipo localmente.
VITE_PROTOTIPO=true